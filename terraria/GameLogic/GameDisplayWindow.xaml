<Window x:Class="WPFTerraria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFTerraria"
        xmlns:userControls="clr-namespace:WPFTerraria.View"

       mc:Ignorable="d"
       Title="GameDisplayWindow" x:Name="GameWindow" Height="450" Width="800"

       SnapsToDevicePixels="True">

   <Grid>


       <!-- <DataGrid x:Name="dataGrid" AutoGenerateColumns="True"
     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
     Margin="700,10,0,10" Width="200" FontSize="15"
     Panel.ZIndex="1"/> -->

        <!-- can wrap scrollviewer in scrollviewer -->
        <!-- <ScrollViewer HorizontalScrollBarVisibility="Auto"
VerticalScrollBarVisibility="Auto"> -->
        <Canvas x:Name="GameCanvas" Background="LightBlue" >
            <!-- FPS display -->
            <TextBlock x:Name="fpsTextBlock"
               Text="Fps"
               Foreground="White"
               FontSize="16"
               FontWeight="Bold"
               Panel.ZIndex="100">
                <TextBlock.Effect>
                    <!-- black outline effect -->
                    <DropShadowEffect ShadowDepth="2"
                          BlurRadius="6"
                          Color="Black"
                          Opacity="5"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="timeTextBlock"
                Text="time"
                Foreground="White"
                FontSize="16"
                FontWeight="Bold"
                Panel.ZIndex="101"
                >
                <TextBlock.Effect>
                    <!-- black outline effect -->

                   <DropShadowEffect ShadowDepth="2"
                       BlurRadius="6"
                       Color="Black"
                       Opacity="5"/>
               </TextBlock.Effect>
           </TextBlock>


           <TextBlock x:Name="deathTextBlock"
               Visibility="Collapsed"
               Text="20"
               Foreground="White"
               FontSize="40"
               FontWeight="Bold"
               Panel.ZIndex="101"
               HorizontalAlignment="Left"
               VerticalAlignment="Top">

               <TextBlock.Effect>

                   <!-- black outline effect -->
                   <DropShadowEffect ShadowDepth="2"
                       BlurRadius="6"
                       Color="Black"
                       Opacity="5"/>

               </TextBlock.Effect>
           </TextBlock>

            <Rectangle x:Name="PlayerHitboxRect" Fill="Transparent"
Stroke="Red" StrokeThickness="2"
                           Tag="Hitbox" />

            <Rectangle x:Name="PlayerHitboxCenterRect" Fill="Transparent"
Stroke="Red" StrokeThickness="4"

                           Tag="Hitbox" />
            <Rectangle x:Name="ToolHitbox" Fill="Transparent" Stroke="Red"
StrokeThickness="2"
                           Tag="Hitbox" Panel.ZIndex="10" />

       </Canvas>


       <Canvas x:Name="InventoryHudCanvas" Panel.ZIndex="5"/>
       <Canvas x:Name="FullInventoryCanvas" Panel.ZIndex="11"/>
       <Canvas x:Name="PauseMenuCanvas" Panel.ZIndex="20"/>
       <Canvas x:Name="GenderSelectionCanvas" Panel.ZIndex="22"/>
       <Canvas x:Name="MapSizeCanvas" Panel.ZIndex="21"/>
       <Canvas x:Name="MainMenuCanvas" Panel.ZIndex="25"/>
       <Canvas x:Name="HealthBarCanvas" Panel.ZIndex="4"/>
       <Canvas x:Name="HealthTimerCanvas" Panel.ZIndex="4"/>

        <Canvas x:Name="ItemNotificationCanvas" HorizontalAlignment="Right"
VerticalAlignment="Bottom"
            Margin="0,0,20,15" IsHitTestVisible="False" Width="300"
Height="200" Panel.ZIndex="5"/>

    </Grid>
</Window>
