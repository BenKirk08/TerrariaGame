<UserControl x:Class="WPFTerraria.PlayerHealthBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-
compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFTerraria"
             mc:Ignorable="d"
             d:DesignHeight="25" d:DesignWidth="250">
    <Grid>
        <ProgressBar x:Name="HealthBar" Width="250" Height="25"
Value="{Binding PlayerHealthPercentage}" Foreground="LimeGreen"
Background="Red"></ProgressBar>
        <TextBlock x:Name="HealthBarTxt" Text="{Binding HealthText}"
FontSize="15" Foreground="WhiteSmoke" Margin="5,2,0,1">
            <TextBlock.Effect>
                <!-- black outline effect -->
                <DropShadowEffect ShadowDepth="2"
                    BlurRadius="6"
                    Color="Black"
                    Opacity="5"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</UserControl>
