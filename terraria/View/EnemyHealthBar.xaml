<UserControl x:Class="WPFTerraria.EnemyHealthBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-
compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFTerraria"
             mc:Ignorable="d"
             d:DesignHeight="8" d:DesignWidth="45">
    <Grid>
        <ProgressBar x:Name="EnemyHealthBarProgress" Width="45" Height="8"
Value="{Binding EnemyHealthPercentage}" Foreground="LimeGreen"
Background="Red"></ProgressBar>
        <TextBlock x:Name="EnemyHealthBarTxt" Text="{Binding EnemyHealthTxt}"
FontSize="5.5" Foreground="WhiteSmoke" Margin="0,0,0,0" FontWeight="Bold"
TextAlignment="Center">
            <TextBlock.Effect>
                <!-- black outline effect -->
                <DropShadowEffect ShadowDepth="2"
                                    BlurRadius="6"
                                    Color="Black"
                                    Opacity="5"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</UserControl>
