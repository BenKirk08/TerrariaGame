<UserControl x:Class="WPFTerraria.View.FullInventoryDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-
compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFTerraria.View"
             mc:Ignorable="d"
             d:DesignHeight="271" d:DesignWidth="264">
    <Grid>
        <Canvas x:Name="FullInventory">


       <!-- Item Split + Remove Panel -->
           <Border x:Name="ItemSplitPanel"
           Visibility="Collapsed"
           Background="#CC1E1E1E"
           CornerRadius="8"
           Padding="6"
           Width="150"
           Height="90"
           BorderBrush="#444"
           BorderThickness="1"
           Panel.ZIndex="999">
               <Grid>
                   <Grid.RowDefinitions>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                       <RowDefinition Height="Auto"/>
                   </Grid.RowDefinitions>

                   <!-- Split controls -->
                   <StackPanel Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   Grid.Row="0">
                       <TextBlock x:Name="LeftSplitText" Text="0"
                    Foreground="White" FontWeight="Bold" Margin="0,0,6,0"/>
                       <Slider x:Name="SplitSlider" Minimum="1" Maximum="1"
Width="70"
                 ValueChanged="SplitSlider_ValueChanged"/>
                       <TextBlock x:Name="RightSplitText" Text="0"
                    Foreground="White" FontWeight="Bold" Margin="6,0,0,0"/>
                   </StackPanel>

                   <!-- Buttons -->
                   <Button x:Name="ConfirmSplitButton"
               Content="Split"
               Width="60" Height="22" Margin="0,6,0,0"
               Grid.Row="1" HorizontalAlignment="Center"
               Click="ConfirmSplitButton_Click"/>

                   <Button x:Name="RemoveItemButton"
               Content="Remove"
               Width="60" Height="22" Margin="0,6,0,0"
               Grid.Row="2" HorizontalAlignment="Center"
               Background="#AAFF4040"
               Click="RemoveItemButton_Click"/>
               </Grid>
           </Border>
       </Canvas>
   </Grid>

</UserControl>
