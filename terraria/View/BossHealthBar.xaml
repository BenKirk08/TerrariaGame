<UserControl x:Class="WPFTerraria.BossHealthBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-
compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFTerraria"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="400">
    <Grid>
        <ProgressBar x:Name="EnemyHealthBarProgress" Width="400" Height="30"
Value="{Binding BossHealthPercentage}" Foreground="DarkViolet"
Background="PaleVioletRed"></ProgressBar>
        <TextBlock x:Name="EnemyHealthBarTxt" Text="{Binding BossHealthTxt}"
FontSize="20" Foreground="WhiteSmoke" Margin="0,4,0,0" FontWeight="Bold"
TextAlignment="Center">
            <TextBlock.Effect>
                <!-- black outline effect -->
                <DropShadowEffect ShadowDepth="2"
                                BlurRadius="6"
                                Color="Black"
                                Opacity="5"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</UserControl>
