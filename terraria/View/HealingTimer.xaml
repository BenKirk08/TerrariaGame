<UserControl x:Class="WPFTerraria.HealingTimer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-
compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFTerraria"
             mc:Ignorable="d"
             d:DesignHeight="30" d:DesignWidth="22">
    <Grid>
        <Canvas x:Name="HealingTimerCanvas">
            <TextBlock x:Name="HealthTimerTextBlock" Text="{Binding
HealthTimerText}" FontSize="15" Foreground="WhiteSmoke" Width="22"
                       Height ="30" Margin="0,10,0,0" TextAlignment="Center"
Panel.ZIndex ="2" >
                <TextBlock.Effect>
                    <!-- black outline effect -->
                    <DropShadowEffect ShadowDepth="2"
                        BlurRadius="6"
                        Color="Black"
                        Opacity="5"/>
                </TextBlock.Effect>
            </TextBlock>
        </Canvas>

    </Grid>
</UserControl>
