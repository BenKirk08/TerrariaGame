<UserControl x:Class="WPFTerraria.View.InventorySlotDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-
compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFTerraria.View"
             mc:Ignorable="d"
             d:Height="30" d:Width="30"
             >
    <Grid>
        <!-- background image of this slot currently -->
        <Image x:Name="SlotDisplayImage" Source="{Binding CurrentSlotImage}"
               Stretch="Fill" Panel.ZIndex="1"/>

       <!-- SlotPlace of this slot -->
       <TextBlock x:Name="SlotPlaceText" Text="{Binding SlotPlace}"
              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2"
                  Foreground="Gray" FontSize="6" Panel.ZIndex="3"/>

        <!-- item image -->
        <Image x:Name="ItemImageDisplay" Source="{Binding
ThisInventoryItem.ItemImage, UpdateSourceTrigger=PropertyChanged}"
               Stretch="Uniform" d:Width="24" d:Height="24" Margin="3"
Panel.ZIndex="2"/>
        <!-- quantity text -->
        <TextBlock x:Name="QuantityTextDisplay" Text="{Binding
ThisInventoryItem.Quantity, UpdateSourceTrigger=PropertyChanged}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="2" Foreground="White" FontSize="10"
FontWeight="Bold" Panel.ZIndex="3"/>
    </Grid>
</UserControl>
