<UserControl x:Class="WPFTerraria.View.CraftingMenuDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-
compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPFTerraria.View"
             mc:Ignorable="d"
                Width="420" Height="360">
    <Grid>
        <Border Background="#111D" BorderBrush="#444" BorderThickness="1"
CornerRadius="10"/>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                <TextBlock Text="Crafting" FontWeight="Bold"
Foreground="White" FontSize="16"/>
                <CheckBox x:Name="ShowOnlyCraftable" Content="Only craftable"
Margin="12,0,0,0"
                  Foreground="White" VerticalAlignment="Center"
IsChecked="True"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="ListHost" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
